  "fixed_sql": [
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"servings\" REAL NOT NULL, \"steps\" TEXT NOT NULL DEFAULT '[]', \"source_url\" TEXT NULL, \"thumbnail\" BLOB NULL);"
        }
      ]
    },
    {
      "name": "ingredient_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredient_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"recipe_id\" INTEGER NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"original\" TEXT NOT NULL, \"quantity\" REAL NULL, \"unit\" TEXT NULL, \"name\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "slot_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"slot_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"date\" INTEGER NOT NULL, \"meal\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"free_text\" TEXT NULL, \"recipe_id\" INTEGER NULL REFERENCES recipes (id), \"servings\" REAL NULL, CHECK ((free_text IS NULL) <> (recipe_id IS NULL)));"
        }
      ]
    },
    {
      "name": "shopping_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_checks\" (\"week\" INTEGER NOT NULL, \"entry_key\" TEXT NOT NULL, \"checked_quantity\" REAL NULL, PRIMARY KEY (\"week\", \"entry_key\"));"
        }
      ]
    },
    {
      "name": "manual_shopping_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"manual_shopping_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"week\" INTEGER NOT NULL, \"label\" TEXT NOT NULL, \"checked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"checked\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "ingredient_aliases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredient_aliases\" (\"from_name\" TEXT NOT NULL, \"to_name\" TEXT NOT NULL, PRIMARY KEY (\"from_name\"));"
        }
      ]
    },
    {
      "name": "section_overrides",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"section_overrides\" (\"name\" TEXT NOT NULL, \"section\" INTEGER NOT NULL, PRIMARY KEY (\"name\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"key\" TEXT NOT NULL UNIQUE);"
        }
      ]
    },
    {
      "name": "recipe_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_tags\" (\"recipe_id\" INTEGER NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"tag_id\" INTEGER NOT NULL REFERENCES tags (id) ON DELETE CASCADE, PRIMARY KEY (\"recipe_id\", \"tag_id\"));"
        }
      ]
    },
    {
